# LLM
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextforge_neo4j

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://contextforge:contextforge_pg@postgres:5432/contextforge

# External APIs
ARXIV_RATE_LIMIT_PER_SECOND=3
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=your_github_token_here
NEWS_API_KEY=your_newsapi_key_here

# Pipeline
CONFIDENCE_THRESHOLD=0.7
GAP_TEMPORAL_YEARS=5

# Security
# Secret used to sign access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ENV=development

# Google Sign-In
# OAuth 2.0 Web client ID from Google Cloud Console. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google sign-in entirely.
GOOGLE_CLIENT_ID=

# App
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

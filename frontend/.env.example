# Frontend environment variables (Vite exposes VITE_* via import.meta.env).
# Copy this file to `.env` and adjust as needed.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to use hardcoded mock data from src/api/mock.js
# (no backend required). Set to "false" to call the real API.
VITE_USE_MOCK_API=false

# Google Sign-In: OAuth 2.0 Web client ID (same value as the backend's
# GOOGLE_CLIENT_ID). Add http://localhost:5173 and your deployed origin under
# "Authorized JavaScript origins" for that client. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
